#!/usr/bin/env node
import { spawnSync } from 'node:child_process';
import { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { basename, dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { dispatch, fail, list, parseStrict } from '../scripts/lib/args.mjs';
import { splitFrontmatter } from '../scripts/lib/frontmatter.mjs';
import { matchesAny } from '../scripts/lib/globs.mjs';
import {
  PROFILE_SCHEMA_VERSION,
  allCommands,
  commandSpec,
  getKey,
  hashSources,
  loadProfile,
  renderCommand,
  saveProfile,
  setKey,
  shellQuote,
  staleSources,
  validateProfile,
} from '../scripts/lib/profile.mjs';
import { writeAll } from '../scripts/lib/hookio.mjs';
import { repoRoot, untrackedFiles, venDir, workingTreeHash } from '../scripts/lib/repo.mjs';
import { appendVerify, readJson, writeJson } from '../scripts/lib/state.mjs';

const USAGE = `ven-profile: the repo profile (stack facts + verified commands), stored in <git-common-dir>/ven

  ven-profile path                         print the state directory
  ven-profile init                         create the state directory skeleton
  ven-profile detect                       list signal files per source, for onboarding workers
  ven-profile show | get <key>             print the profile or one key (e.g. commands.test.single)
  ven-profile set <key> <json|string>      set one key
  ven-profile write < profile.json         replace the whole profile (validated); stamps generated_at and source hashes
  ven-profile stamp                        re-stamp generated_at and source hashes, change nothing else
  ven-profile validate                     check the profile against the schema
  ven-profile run <key> [--file F]... [--var name=value]...   run a profile command, filling {file}/{files}/{name}
  ven-profile prove [<key>...] [--strict]  run commands once and mark each verified or unverified (--strict: exit 1 on any FAIL)
  ven-profile verify <key> [--file F]...   run a verify command and log the result against the current tree
                                           (exit 1 and no pass if existing files changed while it ran;
                                           files the command newly creates are fine)
  ven-profile fresh                        exit 1 if manifests or lockfiles changed since the profile was stamped
  ven-profile adapters                     print adapters.json (capability → command)
  ven-profile adapter <capability> [--file F] [--var name=value]   run a verified adapter
  ven-profile prove-adapters [<capability>...]                     prove adapters like prove does commands
  ven-profile playbooks                    list core and pack playbooks with their descriptions
  ven-profile packs-for <file>...          list enabled packs whose applies_when matches the files

  exit codes: 0 ok, 1 failure, 2 usage error, 3 adapter missing or unproven`;

const PLUGIN_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const [command, ...rest] = process.argv.slice(2);
const { flags, positionals } = parseStrict(rest, { values: ['file', 'var', 'timeout'], booleans: ['strict'] });
const cwd = process.cwd();

function requireProfile() {
  const loaded = loadProfile(cwd);
  if (!loaded) fail('ven-profile: no profile for this repo; run /ven:onboard first');
  return loaded;
}

function print(value) {
  console.log(typeof value === 'string' ? value : JSON.stringify(value, null, 2));
}

function readStdin() {
  return readFileSync(0, 'utf8');
}

function parseValue(raw) {
  try {
    return JSON.parse(raw);
  } catch {
    return raw;
  }
}

// `--var name=value` fills {name}; {file}/{files} come from --file.
function templateVars() {
  const vars = Object.fromEntries(list(flags.var).map((pair) => pair.split(/=(.*)/s).slice(0, 2)).map(([name, value]) => [name, shellQuote(value ?? '')]));
  const quoted = list(flags.file).map(shellQuote);
  return { ...vars, file: quoted[0] ?? '', files: quoted.join(' ') };
}

function execute(spec, timeoutSeconds) {
  const { root } = requireProfile();
  const commandLine = renderCommand(spec.run, templateVars());
  const started = Date.now();
  const result = spawnSync(commandLine, {
    cwd: join(root, spec.cwd ?? '.'),
    shell: true,
    encoding: 'utf8',
    timeout: (timeoutSeconds ?? spec.timeout_s ?? 600) * 1000,
    maxBuffer: 64 * 1024 * 1024,
  });
  const output = `${result.stdout ?? ''}${result.stderr ?? ''}`;
  const exit = result.error?.code === 'ETIMEDOUT' ? 124 : (result.status ?? 1);
  return { commandLine, exit, seconds: Math.round((Date.now() - started) / 1000), output };
}

// Signal sources map one-to-one to onboarding detect workers.
const SIGNALS = {
  manifests: /(^|\/)(package\.json|pyproject\.toml|setup\.py|requirements[^/]*\.txt|Cargo\.toml|go\.mod|Gemfile|composer\.json|pom\.xml|build\.gradle(\.kts)?|mix\.exs|deno\.jsonc?|\w+\.csproj)$/,
  lockfiles: /(^|\/)(package-lock\.json|pnpm-lock\.yaml|yarn\.lock|bun\.lockb?|poetry\.lock|uv\.lock|Pipfile\.lock|Cargo\.lock|go\.sum|Gemfile\.lock|composer\.lock|mix\.lock)$/,
  workspaces: /(^|\/)(pnpm-workspace\.yaml|turbo\.json|nx\.json|lerna\.json|rush\.json|go\.work)$/,
  ci: /(^\.github\/workflows\/.+\.ya?ml|^\.gitlab-ci\.yml|^\.circleci\/config\.yml|^Jenkinsfile|^azure-pipelines\.yml|^bitbucket-pipelines\.yml)$/,
  scripts: /(^|\/)(Makefile|Justfile|Taskfile\.ya?ml|Procfile)$|^scripts\//,
  quality: /(^|\/)(\.?eslint[^/]*|biome\.jsonc?|\.prettierrc[^/]*|prettier\.config\.\w+|tsconfig[^/]*\.json|\.editorconfig|ruff\.toml|\.flake8|mypy\.ini|\.golangci\.ya?ml|rustfmt\.toml|clippy\.toml|\.dependency-cruiser[^/]*|\.rubocop\.yml)$/,
  tests: /(^|\/)(vitest|jest|playwright|cypress|karma|mocha)[^/]*\.config\.\w+$|(^|\/)(pytest\.ini|conftest\.py|\.mocharc[^/]*)$/,
  runtime: /(^|\/)(docker-compose[^/]*\.ya?ml|compose\.ya?ml|Dockerfile[^/]*|\.env\.example|\.env\.sample|\.nvmrc|\.node-version|\.tool-versions|\.python-version|\.worktreeinclude)$/,
  agent_docs: /(^|\/)(CLAUDE\.md|AGENTS\.md|GLOSSARY\.md|CONTEXT\.md|CONTRIBUTING\.md)$|(^|\/)(adr|adrs|decisions)\/.+\.md$|^\.claude\/|^\.cursor\//,
};

const commands = {
  path() {
    print(venDir(cwd) ?? fail('ven-profile: not inside a git repository'));
  },
  init() {
    const dir = venDir(cwd) ?? fail('ven-profile: not inside a git repository');
    for (const sub of ['solutions', 'baseline', 'packs/.claude-plugin', 'state']) mkdirSync(join(dir, sub), { recursive: true });
    const marketplace = join(dir, 'packs', '.claude-plugin', 'marketplace.json');
    if (!existsSync(marketplace)) {
      const name = `ven-local-${basename(repoRoot(cwd)).replace(/[^a-zA-Z0-9.-]/g, '-')}`;
      writeFileSync(marketplace, `${JSON.stringify({ name, owner: { name: 'ven' }, description: 'Packs forged for this repo', plugins: [] }, null, 2)}\n`);
    }
    print(dir);
  },
  detect() {
    const root = repoRoot(cwd) ?? fail('ven-profile: not inside a git repository');
    const tracked = spawnSync('git', ['ls-files', '--cached', '--others', '--exclude-standard'], { cwd: root, encoding: 'utf8', maxBuffer: 256 * 1024 * 1024 });
    const files = tracked.stdout.split('\n').filter(Boolean);
    const found = Object.fromEntries(Object.keys(SIGNALS).map((source) => [source, []]));
    for (const file of files) {
      for (const [source, pattern] of Object.entries(SIGNALS)) if (pattern.test(file)) found[source].push(file);
    }
    const topDirs = [...new Set(files.map((file) => file.split('/')[0]).filter((part) => !part.includes('.')))];
    print({ root, file_count: files.length, top_level_dirs: topDirs, signals: found });
  },
  show() {
    print(requireProfile().profile);
  },
  get() {
    const value = getKey(requireProfile().profile, positionals[0] ?? fail('usage: ven-profile get <key>', 2));
    if (value === undefined) fail(`ven-profile: ${positionals[0]} is not set`);
    print(value);
  },
  set() {
    const [key, raw] = positionals;
    if (!key || raw === undefined) fail('usage: ven-profile set <key> <json|string>', 2);
    const { dir, profile } = requireProfile();
    setKey(profile, key, parseValue(raw));
    const errors = validateProfile(profile);
    if (errors.length > 0) fail(`ven-profile: invalid after set:\n${errors.join('\n')}`);
    saveProfile(dir, profile);
    print(`set ${key}`);
  },
  write() {
    const dir = venDir(cwd) ?? fail('ven-profile: not inside a git repository');
    const profile = parseStdinJson();
    profile.schema_version ??= PROFILE_SCHEMA_VERSION;
    stampSources(profile, repoRoot(cwd));
    const errors = validateProfile(profile);
    if (errors.length > 0) fail(`ven-profile: invalid profile:\n${errors.join('\n')}`);
    saveProfile(dir, profile);
    print(`profile written to ${dir}/profile.json`);
  },
  stamp() {
    const { dir, root, profile } = requireProfile();
    stampSources(profile, root);
    saveProfile(dir, profile);
    print(`stamped ${Object.keys(profile.stack.source_hashes).length} sources at ${profile.generated_at}`);
  },
  validate() {
    const errors = validateProfile(requireProfile().profile);
    if (errors.length > 0) fail(errors.join('\n'));
    print('profile is valid');
  },
  run() {
    const key = positionals[0] ?? fail('usage: ven-profile run <key> [--file F]...', 2);
    const spec = commandSpec(requireProfile().profile, key) ?? fail(`ven-profile: no command at ${key}`);
    const result = execute(spec, flags.timeout && Number(flags.timeout));
    writeAll(1, result.output);
    process.exit(result.exit);
  },
  prove() {
    const { profile } = requireProfile();
    const keys = positionals.length > 0 ? positionals.map(qualify) : Object.keys(allCommands(profile));
    const hasFile = list(flags.file).length > 0;
    const outcomes = [];
    for (const key of keys) {
      const spec = getKey(profile, key);
      if (!spec?.run) continue;
      const needsFile = /\{files?\}/.test(spec.run);
      if (spec.status === 'manual' || (needsFile && !hasFile)) {
        console.log(`skip  ${key} (${spec.status === 'manual' ? 'manual' : 'needs a file argument; prove it with --file <path>'})`);
        continue;
      }
      const result = execute(spec, spec.timeout_s);
      const outcome = proofOf(result);
      outcomes.push({ key, outcome });
      console.log(`${result.exit === 0 ? 'ok   ' : 'FAIL '} ${key}  \`${result.commandLine}\`  (${outcome.proof})`);
    }
    // Commands can run for minutes; merge into a fresh read so a `set` made meanwhile survives.
    const { dir, profile: fresh } = requireProfile();
    for (const { key, outcome } of outcomes) {
      const target = getKey(fresh, key);
      if (target) applyProof(target, outcome);
    }
    saveProfile(dir, fresh);
    if (flags.strict && outcomes.some(({ outcome }) => outcome.status !== 'verified')) process.exit(1);
  },
  verify() {
    const key = positionals[0] ?? fail('usage: ven-profile verify <key> [--file F]...', 2);
    const { dir, root, profile } = requireProfile();
    const spec = commandSpec(profile, key) ?? fail(`ven-profile: no command at ${key}`);
    const before = workingTreeHash(root);
    const untrackedBefore = new Set(untrackedFiles(root));
    const result = execute(spec, flags.timeout && Number(flags.timeout));
    const tree = workingTreeHash(root);
    // A file the command created is output, not drift: only content that existed before must be unchanged.
    const created = untrackedFiles(root).filter((file) => !untrackedBefore.has(file));
    const unchanged = tree === before || workingTreeHash(root, { exclude: created }) === before;
    const entry = { tree, key, command: result.commandLine, exit: result.exit, seconds: result.seconds, worktree: repoRoot(cwd) };
    writeAll(1, result.output);
    if (!unchanged) {
      appendVerify(dir, { ...entry, tree_changed: true });
      fail(`ven-profile verify: the tree changed while ${key} ran (exit ${result.exit}), so no pass is logged. Re-run: ven-profile verify ${key}`);
    }
    appendVerify(dir, entry);
    console.log(`\nven-profile verify: ${key} exit ${result.exit}; logged against tree ${tree.slice(0, 12)}`);
    process.exit(result.exit);
  },
  fresh() {
    const { root, profile } = requireProfile();
    const stale = staleSources(profile, root);
    if (stale.length === 0) return print('profile is fresh');
    fail(`profile is stale: ${stale.join(', ')} changed since ${profile.generated_at}; run ven-profile stamp if the profile still holds, else /ven:onboard --refresh`);
  },
  adapters() {
    print(readAdapters());
  },
  adapter() {
    const capability = positionals[0] ?? fail('usage: ven-profile adapter <capability> [--file F] [--var name=value]', 2);
    const spec = readAdapters()[capability];
    if (!spec?.run) fail(`ven-profile: no adapter for ${capability}; fall back to reading files and suggest forge-adapter`, 3);
    if (spec.status !== 'verified') fail(`ven-profile: adapter ${capability} is ${spec.status}; prove it first (ven-profile prove-adapters ${capability})`, 3);
    const result = execute(spec, flags.timeout && Number(flags.timeout));
    writeAll(1, result.output);
    process.exit(result.exit);
  },
  'prove-adapters'() {
    const adapters = readAdapters();
    const outcomes = [];
    for (const capability of positionals.length > 0 ? positionals : Object.keys(adapters)) {
      const spec = adapters[capability];
      if (!spec?.run || spec.status === 'manual') continue;
      const result = execute(spec, spec.timeout_s);
      outcomes.push({ capability, outcome: proofOf(result) });
      console.log(`${result.exit === 0 ? 'ok   ' : 'FAIL '} ${capability}  \`${result.commandLine}\``);
    }
    const fresh = readAdapters();
    for (const { capability, outcome } of outcomes) if (fresh[capability]) applyProof(fresh[capability], outcome);
    writeJson(adaptersPath(), fresh);
    if (flags.strict && outcomes.some(({ outcome }) => outcome.status !== 'verified')) process.exit(1);
  },
  playbooks() {
    const loaded = loadProfile(cwd);
    const corePaths = readdirSync(join(PLUGIN_ROOT, 'skills', 'do', 'playbooks'))
      .filter((file) => file.endsWith('.md'))
      .map((file) => ({ source: 'core', path: join(PLUGIN_ROOT, 'skills', 'do', 'playbooks', file) }));
    const packPaths = (loaded?.profile.packs ?? []).flatMap((pack) =>
      (pack.playbooks ?? []).map((path) => ({ source: `pack ${pack.name}`, path, applies_when: pack.applies_when })),
    );
    const playbooks = [...corePaths, ...packPaths].map((entry) => {
      const { data } = existsSync(entry.path) ? splitFrontmatter(readFileSync(entry.path, 'utf8'), { strict: false }) : { data: null };
      return { name: data?.name ?? basename(entry.path, '.md'), ...entry, description: data?.description ?? '(missing file)' };
    });
    print(playbooks);
  },
  'packs-for'() {
    const { profile } = requireProfile();
    const files = positionals;
    const matching = (profile.packs ?? []).filter((pack) => {
      const paths = pack.applies_when?.paths ?? [];
      return paths.length === 0 || files.some((file) => matchesAny(file, paths));
    });
    print(matching.map(({ name, plugin, skills, playbooks }) => ({ name, plugin, skills, playbooks })));
  },
};

function adaptersPath() {
  return join(requireProfile().dir, 'adapters.json');
}

function readAdapters() {
  return readJson(adaptersPath(), {});
}

function parseStdinJson() {
  try {
    return JSON.parse(readStdin());
  } catch (error) {
    throw new Error(`stdin is not valid JSON: ${error.message}`);
  }
}

function proofOf(result) {
  const proof = `exit ${result.exit} in ${result.seconds}s at ${new Date().toISOString()}`;
  if (result.exit === 0) return { status: 'verified', proof };
  return { status: 'unverified', proof, failure_tail: result.output.trim().split('\n').slice(-20).join('\n') };
}

function applyProof(spec, { status, proof, failure_tail }) {
  spec.status = status;
  spec.proof = proof;
  if (failure_tail === undefined) delete spec.failure_tail;
  else spec.failure_tail = failure_tail;
}

function stampSources(profile, root) {
  profile.generated_at = new Date().toISOString();
  profile.stack = { ...profile.stack, source_hashes: hashSources(profile.stack?.sources ?? [], root) };
}

function qualify(key) {
  return key.startsWith('commands.') || key.startsWith('workspaces.') ? key : `commands.${key}`;
}

dispatch('ven-profile', USAGE, commands, command);
